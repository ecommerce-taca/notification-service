# --- Runtime ---
NODE_ENV=development
PORT=8080
SERVICE_NAME=notification-service
SERVICE_VERSION=0.1.0

# --- MySQL (notificationdb) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=notification
DB_PASSWORD=change-me
DB_NAME=notificationdb

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_CONSUMER_GROUP_ID=notification-service
# topic nguồn lắng nghe (phân tách bằng dấu phẩy)
KAFKA_TOPIC_COMMANDS=notification.commands.v1
KAFKA_TOPIC_DOMAIN_EVENTS=order.events.v1,invoice.events.v1,shipment.events.v1,payment.events.v1,wallet.events.v1

# --- Email (SMTP). Ví dụ Gmail cá nhân: ---
# SMTP_HOST=smtp.gmail.com · SMTP_PORT=587 · SMTP_SECURE=false
# SMTP_USER=ban@gmail.com · SMTP_PASSWORD=<App Password 16 ký tự, không phải mật khẩu thường>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Taca
EMAIL_FROM_ADDRESS=no-reply@taca.vn

# --- Auth / JWT (JWKS của auth-user) ---
JWT_ISSUER=https://auth.taca.vn
JWT_AUDIENCE=taca-api
JWT_JWKS_URL=http://auth-user.internal:8080/.well-known/jwks.json

# --- Admin delivery: hash recipient bằng HMAC để không lộ email thô ---
RECIPIENT_HASH_SECRET=change-me-32-chars-minimum-secret
# --- Mã hoá recipient (email/phone) at-rest bằng AES-256-GCM ---
RECIPIENT_ENCRYPTION_SECRET=change-me-encryption-32-chars-minimum
